{
  "title": "Rip Current",
  "format": "drill",
  "look": "drill-quest",
  "voice": {
    "narrator": "IKne3meq5aSn9XLyUdCD"
  },
  "bed": "pulse",
  "bed_gain": 0.42,
  "gap": 0.1,
  "lines": [
    {
      "id": "a1",
      "who": "narrator",
      "say": "You are swimming hard, and the beach is moving away.",
      "key": [
        "beach"
      ]
    },
    {
      "id": "a2",
      "who": "narrator",
      "say": "That is probably a rip current.",
      "key": [
        "rip"
      ]
    },
    {
      "id": "q1",
      "who": "narrator",
      "say": "Quest one. Stop swimming toward the beach.",
      "key": [
        "Stop"
      ]
    },
    {
      "id": "q1b",
      "who": "narrator",
      "say": "A rip can move faster than an Olympic swimmer, and you are not one.",
      "key": [
        "faster"
      ]
    },
    {
      "id": "q1c",
      "who": "narrator",
      "say": "Straight back is what drains your stamina.",
      "key": [
        "drains"
      ]
    },
    {
      "id": "q2",
      "who": "narrator",
      "say": "Quest two. Breathe, and float.",
      "key": [
        "float"
      ]
    },
    {
      "id": "q2b",
      "who": "narrator",
      "say": "It pulls you away from shore, not under. Think treadmill, not drain.",
      "key": [
        "under"
      ]
    },
    {
      "id": "q3",
      "who": "narrator",
      "say": "Quest three. If you can swim, try sideways, along the beach.",
      "key": [
        "sideways"
      ]
    },
    {
      "id": "q3b",
      "who": "narrator",
      "say": "It feels like the whole sea, but rips are often narrow. Get out the side, then angle back in.",
      "key": [
        "narrow"
      ]
    },
    {
      "id": "q4",
      "who": "narrator",
      "say": "Quest four. Too tired for that? Float until it weakens, then angle in.",
      "key": [
        "weakens"
      ]
    },
    {
      "id": "q5",
      "who": "narrator",
      "say": "Quest five. Any time you can't make it, face the beach, wave your arms, and yell.",
      "key": [
        "yell"
      ]
    },
    {
      "id": "q5b",
      "who": "narrator",
      "say": "Yelling is a valid move.",
      "key": [
        "valid"
      ]
    },
    {
      "id": "e1",
      "who": "narrator",
      "say": "One more thing. Rips often form on calm, sunny days.",
      "key": [
        "sunny"
      ]
    },
    {
      "id": "e2",
      "who": "narrator",
      "say": "So tonight, look up the surf forecast for your next beach.",
      "key": [
        "tonight",
        "forecast"
      ]
    }
  ],
