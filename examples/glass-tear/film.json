  "voice": { "narrator": "onwK4e9ZLuTAKqWW03F9" },
  "bed": "drone",
  "gap": 0.14,
  "lines": [
    { "id": "a1", "who": "narrator", "say": "This drop of glass can take a hammer.", "key": ["hammer"] },
    { "id": "a2", "who": "narrator", "say": "Swing again. Nothing.", "key": ["nothing"] },
    { "id": "a3", "who": "narrator", "say": "It is only melted glass, dripped into cold water.", "key": ["melted", "water"] },
    { "id": "a4", "who": "narrator", "say": "The outside freezes first, into a hard skin.", "key": ["skin"] },
    { "id": "a5", "who": "narrator", "say": "The inside is still hot. As it cools, it tries to shrink.", "key": ["shrink"] },
    { "id": "a6", "who": "narrator", "say": "The skin will not move, so the inside just keeps pulling.", "key": ["pulling"] },
    { "id": "a7", "who": "narrator", "say": "At its tightest, that squeeze is about three elephants on a dime.", "key": ["three", "elephants"] },
    { "id": "a8", "who": "narrator", "say": "A hammer only hits the squeeze. No crack gets in.", "key": ["crack"] },
    { "id": "a9", "who": "narrator", "say": "But the tail is thin enough to snap with your fingers.", "key": ["tail", "snap"] },
    { "id": "a10", "who": "narrator", "say": "Now a crack is inside, where all that pull is waiting.", "key": ["inside"] },
    { "id": "a11", "who": "narrator", "say": "It runs at about a mile a second.", "key": ["mile"] },
    { "id": "a12", "who": "narrator", "say": "The whole drop. Powder.", "key": ["powder"] },
    { "id": "a13", "who": "narrator", "say": "A prince brought these to England in 1660.", "say_as": "A prince brought these to England in sixteen-sixty.", "key": ["1660"] },
    { "id": "a14", "who": "narrator", "say": "A university called the riddle solved in 2017.", "say_as": "A university called the riddle solved in twenty-seventeen.", "key": ["2017"] },
    { "id": "a15", "who": "narrator", "say": "Hold it by the fat end.", "key": ["fat"] }
  ],
