  "lines": [
    {
      "id": "a1",
      "who": "narrator",
      "say": "Your pan is on fire, and your hand is already on the tap.",
      "key": [
        "fire",
        "tap"
      ]
    },
    {
      "id": "r1",
      "who": "narrator",
      "say": "Rule number one. No water.",
      "key": [
        "No",
        "water"
      ]
    },
    {
      "id": "r1b",
      "who": "narrator",
      "say": "It sinks under the hot oil, flashes to steam, and throws the fire at you.",
      "key": [
        "steam",
        "throws"
      ]
    },
    {
      "id": "r2",
      "who": "narrator",
      "say": "Rule number two. If it is small, slide a lid over the pan, and turn off the burner.",
      "key": [
        "lid",
        "burner"
      ]
    },
    {
      "id": "r2b",
      "who": "narrator",
      "say": "Do not carry it to the sink.",
      "key": [
        "carry"
      ]
    },
    {
      "id": "r3",
      "who": "narrator",
      "say": "Rule number three. No peeking. The lid stays on until the pan is cool.",
      "key": [
        "peeking",
        "cool"
      ]
    },
    {
      "id": "r4",
      "who": "narrator",
      "say": "Rule number four. Any doubt? Get out, shut the door, then call.",
      "key": [
        "out",
        "door"
      ]
    },
    {
      "id": "e1",
      "who": "narrator",
      "say": "Tonight, put a lid next to the stove.",
      "key": [
        "Tonight",
        "lid"
      ]
    }
  ],
